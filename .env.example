NODE_ENV=development

APP_PORT=3000
APP_HOST=0.0.0.0

DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB_NAME

LOG_LEVEL=info

JWT_SECRET=

REDIS_URL=redis://localhost:16379

# Comma-separated list of frontend origins allowed to call the API.
# Production: set this to your admin UI domain (e.g. https://panel.example.com).
CORS_ORIGIN=http://localhost:5173

# Path prefix for the public subscription endpoint (default /sub). Lets the
# operator mask the panel signature on the wire, e.g. /v makes user links
# look like https://panel.example.com/v/<token>.
# SUBSCRIPTION_PATH_PREFIX=/sub