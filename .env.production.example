# Copy to `.env.production` and fill in. Used by `docker-compose.prod.yml`.
#
#   cp .env.production.example .env.production
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d
#
# Generated values (JWT_SECRET, POSTGRES_PASSWORD): use openssl.
#   openssl rand -base64 48 | tr -d '\n'

# ============================================================================
# REQUIRED - without these the panel won't start
# ============================================================================

# ───── Postgres ─────
POSTGRES_USER=iceslab
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=iceslab

DATABASE_URL=postgres://iceslab:CHANGE_ME_STRONG_PASSWORD@postgres:5432/iceslab

# Connection-pool ceiling for the panel's postgres connections (1..200).
# The cron fan-out polls every node in parallel; 10 is right for a 2 GB box.
DATABASE_POOL_MAX=10

# ───── Redis ─────
REDIS_URL=redis://redis:6379

# ───── Auth ─────
# Must be ≥32 chars. Generate: openssl rand -base64 48 | tr -d '\n'
JWT_SECRET=CHANGE_ME_at_least_32_characters_long_random_string
JWT_EXPIRES_IN=24h

# ───── Public surface ─────
# Public base URL of this panel (no trailing slash). REQUIRED - used to
# generate bootstrap install commands, subscription links, and the
# panelUrl baked into node payloads (heartbeat self-destruct depends on it).
PUBLIC_URL=https://panel.example.com

# Comma-separated list of frontend origins allowed to call /api directly.
# When SPA is served from the same origin as the API (default deploy), set
# to PUBLIC_URL.
CORS_ORIGIN=https://panel.example.com

# Path prefix for the public subscription endpoint (default /sub). Lets the
# operator mask the panel signature on the wire, e.g. /v makes user links
# look like https://panel.example.com/v/<token>.
# SUBSCRIPTION_PATH_PREFIX=/sub

# Separate public origin for CLIENT subscription links (no trailing slash).
# Unset, subscriptions are served from PUBLIC_URL and one blocked domain takes
# the admin API, node bootstrap and every user's link down together. Point this
# at a cheaper, more disposable domain and only the user-facing half moves when
# it burns. The panel and the install page both follow it, so a rotation is one
# env change plus a redeploy.
# SUBSCRIPTION_PUBLIC_URL=https://sub.example.com

LOG_LEVEL=info

# ============================================================================
# Security (cycle #5 S6/S7 + cycle #6 Tier-1) - set these in prod
# ============================================================================

# Trusted reverse-proxy hops in front of the backend.
#   0 = behind nothing (don't trust X-Forwarded-For - dev / single-host)
#   1 = behind one proxy (Caddy / nginx on same host)
#   2 = behind two proxies (Cloudflare → Caddy → backend). RECOMMENDED.
# Bumping this above the real hop count lets attackers spoof X-Forwarded-For
# and bypass per-IP rate limits.
TRUST_PROXY_HOPS=2

# This panel's public egress IP. Baked into node-install commands as
# --panel-ip so each node's UFW only opens :1337/tcp to THIS IP.
# Auto-detection at runtime via ipify falls back when this is unset.
PANEL_PUBLIC_IP=

# Per-route rate limits (per minute, per IP). Defaults are tuned for a
# small-mid panel; raise for busy multi-thousand-user instances.
RATE_LIMIT_SUB_PER_MIN=30
RATE_LIMIT_BOOTSTRAP_PER_MIN=10
RATE_LIMIT_HEARTBEAT_PER_MIN=120
# The core-artefact download a node installs from. One request is ~21 MB, so
# this is the limit that decides how much disk-to-network a single bearer can
# ask for. An install needs a handful.
RATE_LIMIT_CORE_PER_MIN=20
# Secondary IP-only ceiling for /sub/* (Wave 3). The per-(ip,token) bucket
# above can be dodged by rotating tokens - this catches that. Default 120/min
# is well above legit shared-CGNAT polling (typically <1/min per IP).
RATE_LIMIT_SUB_IP_PER_MIN=120

# Username lockout (Redis-backed, S7 cycle #5).
# 2026-05-20: relaxed alpha defaults from 5/15/15 → 10/5/10 after a live
# bot brute-force on /api/auth/login locked out a legitimate operator for
# 15 min. The lockout is per-username, so any bot doing N failed logins
# against `admin` denies access to the real admin too. The relaxed values
# trade some attacker resistance (still bounded by per-IP rate-limit at
# 5/min in auth.routes.ts) for fewer false-positive lockouts during the
# small-team alpha window. Proper fix tracked for wave-13: per-(IP+user)
# lockout, CAPTCHA after 3 fails, honeypot-IP-ban for common usernames.
LOGIN_LOCKOUT_FAILURES=10
LOGIN_LOCKOUT_DURATION_MIN=5
LOGIN_LOCKOUT_WINDOW_MIN=10

# ACME contact email - auto-injected into Hysteria / Naive node-install
# commands. Optional but recommended (UI emits a placeholder otherwise).
ACME_DEFAULT_EMAIL=admin@example.com

# ───── Tier-1: Telegram alerts (cycle #6) ─────
# Set both to enable login / lockout / honeypot / node-flip / user-expired /
# admin-created / CA-bootstrap push notifications. No-op when either unset.
#   Bot token: @BotFather
#   Chat id: @userinfobot (PM) or -100... (group)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Login/lockout activity is operational PII - shipping every admin sign-in
# IP+username to a third-party chat is opt-in (Wave 4). Set to true if you
# want those alerts; IPs are /24-redacted via redactIp() before sending.
TELEGRAM_NOTIFY_LOGIN_EVENTS=false

# ───── Webhooks (K2) ─────
# Outbound webhook bus: domain events (user/profile/node lifecycle) are POSTed
# as signed JSON so third-party tools (billing bots, dashboards, CRMs) can react
# without polling. Comma-separated URLs; empty = disabled.
# WEBHOOK_URLS=https://bot.example.com/iceslab-hook
# HMAC-SHA256 secret signing each body (X-Iceslab-Signature over
# `${timestamp}.${body}`). Receivers verify it + reject replays via the
# X-Iceslab-Timestamp header. Generate: openssl rand -hex 32
# WEBHOOK_SECRET=

# ───── Tier-1: Geo-block + honeypot (cycle #6) ─────
# CSV of ISO 3166-1 alpha-2 country codes allowed on /api/* (admin paths).
# Empty = disabled. Requires Cloudflare orange-cloud + CF-IPCountry header;
# without that an attacker can spoof the header. Public surfaces (/sub/,
# /api/internal/, /health) bypass this check.
ADMIN_ALLOWED_COUNTRIES=

# Honeypot scanner-trap blacklist TTL (seconds). 3600 = 1h is the default -
# long enough to wear a scanner down, short enough that legit users on
# shared CGNAT aren't permanently locked out.
HONEYPOT_BLACKLIST_TTL_SEC=3600

# Honey subscription tokens (CSV). Tokens admin plants in suspicious channels
# as a leak tripwire - any hit on /sub/<honey> fires a Telegram alert and
# blacklists the source IP. Never matches a real user.
HONEY_USER_TOKENS=

# ============================================================================
# Frontend
# ============================================================================
# Empty = relative requests that the frontend nginx proxies to backend.
# Set explicitly only if you serve the frontend from a different origin.
VITE_API_BASE_URL=

# Host port the frontend listens on (mapped to container :80).
# Behind Caddy/nginx-on-host, leave at 8080 and reverse-proxy to it.
FRONTEND_PORT=8080

# Which host address that port is published on.
#
# 127.0.0.1 (default) = reachable only from this machine, i.e. exactly what a
# reverse proxy on the same host needs. Keep it unless you have a reason.
#
# 0.0.0.0 = reachable from anywhere. Use ONLY when there is no reverse proxy
# and the browser connects straight to this port. Note that the admin UI is
# then served over plain HTTP: the login password crosses the network in clear.
#
# ⚠ You cannot fix an exposed port with the firewall afterwards. Docker DNATs
# published ports before ufw's filter rules run, so `ufw status` will show the
# port closed while the world can still reach it.
FRONTEND_BIND=127.0.0.1

# ============================================================================
# Node-installer supply-chain pinning (Wave 6)
# ============================================================================
# These are read by scripts/install-iceslab-node.sh - set them in the
# operator's shell BEFORE running curl|bash if you want non-default pins.
# Not consumed by the backend container; listed here so operators discover
# them in one place.
#
# Hysteria: apernet/hysteria uses `app/v2.*` tags for the server lineage.
# Bump as upstream releases.
# HYSTERIA_INSTALLER_REF=app/v2.9.1
# HYSTERIA_INSTALLER_SHA=        # optional sha256 of install_server.sh
# HYSTERIA_VERSION=              # if set, passes --version so binary is pinned too
#
# Xray: XTLS/Xray-install publishes ZERO tags - only a `main` branch.
# Default is a pinned commit SHA. To bump: `git ls-remote
# https://github.com/XTLS/Xray-install main` and update SECURITY.md.
# XRAY_INSTALLER_REF=e741a4f56d368afbb9e5be3361b40c4552d3710d
# XRAY_INSTALLER_SHA=            # STRONGLY recommended in production

# Set to 1 if you want the installer to run `apt-get dist-upgrade` during
# install. OFF by default since alpha - dist-upgrade reboots kernels and
# restarts sshd, which surprised operators on early test VPSes.
# DO_OS_UPGRADE=0

# ============================================================================
# Fork-only features (iceslab fork; absent upstream)
# ============================================================================
# Every setting below is OFF by default and the panel behaves exactly as it
# does without them. They were undocumented here until 2026-08-26, which meant
# an operator could not discover the fork's own features from the file they
# read to configure it.

# ───── Remnawave-compat facade ─────
# Serves a Remnawave-shaped API so an UNMODIFIED minishop can drive this panel:
# the shop is pointed at <PUBLIC_URL>/<PREFIX> and needs no changes of its own.
# REMNAWAVE_COMPAT_ENABLED=false
# Path prefix the facade is mounted under. The shop's PANEL_BASE_URL must end
# with it.
# REMNAWAVE_COMPAT_PREFIX=rw
# Outbound events to the shop: its <WEBHOOK_BASE_URL>/webhook/panel plus the
# HMAC-SHA256 secret, which must equal the shop's PANEL_WEBHOOK_SECRET. Either
# one empty and the emitter stays off - the shop then never hears about an
# expiry, a hit limit or a device, and looks like it is ignoring them.
# REMNAWAVE_COMPAT_WEBHOOK_URL=
# REMNAWAVE_COMPAT_WEBHOOK_SECRET=
# How many webhook deliveries run at once. Raise only with a shop that can take
# it; the default was measured, not guessed.
# REMNAWAVE_COMPAT_WEBHOOK_CONCURRENCY=32

# ───── Client portal (send buyers to the shop, not to us) ─────
# When set, a BROWSER opening a subscription link is 302'd here instead of
# seeing the panel's own connection page. Clients that do not ask for text/html
# are untouched, and so is an explicit ?format=.
#
# ⚠ ORDER MATTERS. The panel's page is the only place an AmneziaWG buyer gets
# working per-node QR pairs. Turn this on only after the shop can draw a
# connection page for THIS fleet, or WG buyers are left with no way to connect.
# The subscription token is deliberately NOT appended to the redirect: it is a
# credential, and another origin would write it to its logs and Referer.
# CLIENT_PORTAL_URL=

# ───── Self-hosted geo databases ─────
# Point subscription formats at this panel's own /geo/<token>/ mirror instead of
# upstream URLs, for fleets that cannot reach GitHub or want a pinned set.
# GEO_SELF_HOST=false
# Token in that public path. At least 16 characters; it is the only thing
# between the internet and the artifact endpoint.
# GEO_ARTIFACT_TOKEN=

# ───── Cold-pool hotswap (ext_vptech_pool) ─────
# Promote a spare node into the fleet when a live one goes dark, via ansible.
# EXT_VPTECH_POOL_ENABLED=false
# The promote playbook. Empty keeps the wiring testable without a control node.
# EXT_VPTECH_POOL_ANSIBLE_PLAYBOOK=
# Inventory it runs against; the spare node's `name` must be a host in it
# (--limit <name>). Empty means ansible's own default inventory.
# EXT_VPTECH_POOL_ANSIBLE_INVENTORY=
# Override when ansible-playbook is not on PATH (e.g. ~/.local/bin/...).
# EXT_VPTECH_POOL_ANSIBLE_BIN=ansible-playbook

# ───── Entry diversity ─────
# Makes the entry ORDER keyed (salted with JWT_SECRET) and rotating, instead of
# the same order for everyone forever. It pairs with the `subscriptionEntryPoolSize`
# panel setting: the cap is what turns the ordering into a per-user SLICE of the
# fleet, and the keying is what stops that slice from being recomputable by
# anyone who learns the node set. On its own the ordering is cosmetic.
#
# ⚠ Switching it on MOVES PEOPLE ONCE: the ordering also decides which entry
# most clients dial. Until it is set, the entry order is byte-identical to
# upstream.
# EXT_DIVERSITY_ENABLED=false
# Rotation window in seconds (minimum 60, default one day). A user's slice is
# stable within a window and moves between windows, so a leaked subscription
# decays instead of being a permanent view of the fleet.
# EXT_DIVERSITY_WINDOW_SEC=86400

# ───── HWID ceiling ─────
# Hard cap on distinct device rows recorded per user, applied even to users with
# no per-user or squad device limit. A bound on how fast the table can grow, not
# a product limit.
# HWID_MAX_DEVICES_PER_USER=1000
