+def get_dc_addr(dc_id, table, extra):
+    """The address for a datacenter id, or None when there is no entry.
+
+    None is a distinct answer from "index out of range": the caller has to be
+    able to say which datacenter it could not place, and the old expression
+    could not — it had already turned the id into an index.
+    """
+    if 1 <= dc_id <= len(table):
+        return table[dc_id - 1]
+    return extra.get(dc_id)
+
+
