+# Telegram hands clients datacenter ids OUTSIDE the 1..5 above. 203 is a CDN
+# datacenter, and it is where media from large public channels is downloaded
+# from. The client names it in the proxy handshake exactly as it names 1..5, so
+# `abs(dc) - 1` indexes past the end of the lists and the connection is dropped
+# having sent no byte and logged no line.
+#
+# Measured on this deployment 2026-09-02: of 272 handshakes that reached a user,
+# 136 died that way. Telegram text chat worked throughout and media did not,
+# which is the shape of the failure this table exists to remove.
+#
+# Addresses are verified one at a time by speaking obfuscated2 to them and
+# asking for a resPQ, not read off a published file: getProxyConfig lists
+# `proxy_for 203 91.105.192.110:443`, and that address closes a direct
+# connection — it is a middle-proxy endpoint. 91.105.192.100:443 answers, and it
+# is the address mtg dials for dc 203 on the same node.
+TG_EXTRA_DATACENTERS_V4 = {
+    203: "91.105.192.100",
+}
+
+# Empty on purpose: getProxyConfigV6 publishes 1..5 only, so Telegram offers no
+# IPv6 route to the CDN datacenter. A v6-preferring node therefore falls back to
+# the v4 address rather than dropping the connection — see do_direct_handshake.
+TG_EXTRA_DATACENTERS_V6 = {}
+
 # This list will be updated in the runtime
 TG_MIDDLE_PROXIES_V4 = {
     1: [("149.154.175.50", 8888)], -1: [("149.154.175.50", 8888)],
@@ -1351,6 +1375,18 @@
