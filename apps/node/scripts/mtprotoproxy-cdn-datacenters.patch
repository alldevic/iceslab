+# Every way a connection that has already NAMED A USER can end without relaying
+# a byte. Spelled out rather than accumulated on demand, so each one is exported
+# from the first scrape: a counter that appears only after it fires cannot be
+# alerted on, and its absence cannot be read as "this is not happening".
+DROPPED_REASONS = ("no_telegram", "bad_proto_tag", "tcp_limit", "expired", "quota")
+
+
+def update_dropped(reason):
+    """Count one connection that authenticated a user and relayed nothing.
+
+    Such a connection was invisible in every counter this proxy had.
+    `user_connects` is bumped straight after the handshake and `update_durations`
+    only once the relay has run, so the only way to see these was to subtract the
+    duration histogram and the current-connection gauge from user_connects. That
+    IS how the CDN-datacenter fault was found - 136 of 272 connections on
+    2026-09-02, while Telegram text worked and media did not - and a signal that
+    has to be computed in someone's head by hand is not a signal anyone will
+    compute twice.
+
+    `connects_unknown_dc` stays as it is: it is one REASON inside no_telegram,
+    and knowing the datacenter table is the cause is worth more than not counting
+    the connection twice.
+    """
+    update_stats(connects_dropped=1)
+    update_stats(**{"connects_dropped_%s" % reason: 1})
+
