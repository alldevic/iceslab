model User {
  // Provenance of an imported row: its id in the SOURCE panel. NULL for rows
  // created here, which is the normal case. Makes an import repeatable - a
  // second run matches on this instead of duplicating the set or guessing by
  // username (which the source lets people change). UNIQUE is a PARTIAL index
  // applied in the raw migration (NULLs excluded), so Prisma must not be told
  // to enforce it here.
  sourceId String? @map("source_id") @db.VarChar(128)
  id       String  @id @default(uuid()) @db.Uuid
  // Remnawave-compat: the user's number in the Remnawave 3.x API, where an
  // integer id is the only user reference. Issued by a sequence, never reused,
  // never reissued: a shop stores it as the subscriber's key. Read only by the
  // facade (docs/remnawave-compat.md).
  numericId BigInt @unique @default(autoincrement()) @map("numeric_id")
  shortId  String  @unique @map("short_id") @db.VarChar(16)
  username String  @db.VarChar(64)
  status   String  @default("active") @db.VarChar(16)

  // Subscription window
  expireAt DateTime? @map("expire_at") @db.Timestamptz(6)

  // Traffic
  trafficLimitBytes    BigInt? @map("traffic_limit_bytes")
  trafficLimitStrategy String  @default("no_reset") @map("traffic_limit_strategy") @db.VarChar(16)

  // Subscription URL
  subscriptionToken String    @unique @map("subscription_token") @db.VarChar(64)
  subRevokedAt      DateTime? @map("sub_revoked_at") @db.Timestamptz(6)

  // Pre-generated credentials for all protocols
  hysteriaPassword    String @map("hysteria_password") @db.VarChar(64)
  // The user's AmneziaWG keypair. Since devices (wg_devices) it only seeded
  // device #1 of the users that existed then; nothing reads it, it is kept as
  // the way back.
  amneziawgPrivateKey String @map("amneziawg_private_key") @db.VarChar(64)
  amneziawgPublicKey  String @map("amneziawg_public_key") @db.VarChar(64)
  naivePassword       String @map("naive_password") @db.VarChar(64)
  xrayUuid            String @map("xray_uuid") @db.Uuid

  // Per-user enabled protocols (subset of {hysteria, xray, amneziawg, naive}).
  // Subscription generator filters endpoints by this; default keeps existing
  // users on hysteria-only and admins explicitly opt in to others.
  enabledProtocols Json @default("[\"hysteria\"]") @map("enabled_protocols")

  // Limits
  hwidDeviceLimit Int? @map("hwid_device_limit")

  // R3 - optional per-user routing-preset override. Null = inherit (squad ->
  // global -> default). Highest precedence: wins over squad and global, loses
  // only to the per-request ?routing= query.
  routingPreset String? @map("routing_preset") @db.VarChar(32)
  // A-229 - or the operator's own preset instead. Never both (CHECK
  // users_one_routing_preset); RESTRICT keeps a preset in use from deletion.
  customRoutingPresetId String?        @map("custom_routing_preset_id") @db.Uuid
  customRoutingPreset   RoutingPreset? @relation(fields: [customRoutingPresetId], references: [id], onDelete: Restrict)

  // Slice 27.5: sticky-affinity hint for subscription generator.
  // NULL = no preference (current behaviour). When set, the generator
  // may bias the URL ordering toward this node so the client's url-test
  // group settles on it first. Soft hint: not enforcement, the user's
  // squad ACL still gates access to the node's profiles.
  preferredNodeId String? @map("preferred_node_id") @db.Uuid

  // Metadata (admin-facing)
  description String?
  tag         String? @db.VarChar(64)
  telegramId  BigInt? @map("telegram_id")
  email       String? @db.VarChar(255)

  // Remnawave-compat: the shop's external squad id, stored and echoed back as
  // given. Not a foreign key, not validated, not queried.
  externalSquadUuid String? @map("external_squad_uuid") @db.VarChar(64)

  // Lifecycle
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  traffic              UserTraffic?
  groupMembers         GroupMember[]
  events               SubscriptionEvent[]
  subscriptionRequests SubscriptionRequestHistory[]
  nodeUsageHistory     NodeUserUsageHistory[]
  amneziawgPeers       AmneziawgPeer[]
  hwidDevices          HwidUserDevice[]
  wgDevices            WgDevice[]

  @@index([username])
  @@index([status])
  @@index([expireAt])
  @@index([deletedAt])
  @@index([telegramId])
  @@index([email])
  @@index([customRoutingPresetId])
  @@map("users")
}

/// A-268 tombstone (ARCH 26.10): the source id of an imported user erased for
/// good, as sha256 hex and nothing else, so a later import run of the same
/// source does not bring the erased user back with their old link. Kept
/// forever; no source id itself and nothing about the person.
model ErasedUserSource {
  sourceIdSha256 String   @id @map("source_id_sha256") @db.Char(64)
  erasedAt       DateTime @default(now()) @map("erased_at") @db.Timestamptz(6)

  @@map("erased_user_sources")
}

model UserTraffic {
  userId               String    @id @map("user_id") @db.Uuid
  usedTrafficBytes     BigInt    @default(0) @map("used_traffic_bytes")
  lifetimeTrafficBytes BigInt    @default(0) @map("lifetime_traffic_bytes")
  onlineAt             DateTime? @map("online_at") @db.Timestamptz(6)
  firstConnectedAt     DateTime? @map("first_connected_at") @db.Timestamptz(6)
  lastConnectedNodeId  String?   @map("last_connected_node_id") @db.Uuid
  lastTrafficResetAt   DateTime? @map("last_traffic_reset_at") @db.Timestamptz(6)

  user              User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastConnectedNode Node? @relation(fields: [lastConnectedNodeId], references: [id], onDelete: SetNull)

  @@index([lastConnectedNodeId])
  @@index([onlineAt])
  @@map("user_traffic")
}

// Per-device IP allocation for AmneziaWG profiles. One row per (profile,
// device); the allocator picks the first free IP from the profile's subnet.
// Persisted so a device keeps a stable IP across restarts and so IP exhaustion
// is detected before the awg config changes.
model AmneziawgPeer {
  id        String   @id @default(uuid()) @db.Uuid
  // Slice 27: was `inboundId` pointing at `inbounds`. After profiles
  // refactor, peer allocations are scoped to the logical profile. Same user
  // gets the same WG IP across every node a given profile is bound to
  // (separate WG processes per node never see each other, so no collision).
  profileId String   @map("profile_id") @db.Uuid
  // The device's owner, kept beside deviceId so a user's peers are read
  // without a join.
  userId    String   @map("user_id") @db.Uuid
  deviceId  String   @map("device_id") @db.Uuid
  ip        String   @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  profile Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  device  WgDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([profileId, ip])
  @@unique([profileId, deviceId])
  @@index([userId])
  @@index([deviceId])
  @@map("amneziawg_peers")
}

// A WireGuard device: a keypair (and a preshared key) the panel issued to one
// client of a user. Every client sharing the user's one key meant a second
// client took the endpoint over from the first, and revoking one meant
// revoking all. Not an HwidUserDevice: those are what a client says about
// itself, these are credentials the panel handed out.
//
// How many a user has follows their device limit (wg-devices.service.ts,
// wgDeviceCount); they are issued when a subscription is rendered, oldest
// first is device 1. The AmneziaWG generation is not the device's: the key is
// the same x25519 on 1.x and 3.1, and each profile gives it its own address.
model WgDevice {
  id     String  @id @default(uuid()) @db.Uuid
  userId String  @map("user_id") @db.Uuid
  // A name for the device ("Phone"); NULL until someone names it.
  label  String? @db.VarChar(64)

  privateKey   String  @map("private_key") @db.VarChar(64)
  publicKey    String  @unique @map("public_key") @db.VarChar(64)
  // Mixed into this peer's handshake when its profile asks for preshared keys.
  // NULL on devices from before the column, filled when the subscription is
  // rendered.
  presharedKey String? @map("preshared_key") @db.VarChar(64)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  // A revoked device keeps its row and its traffic; its addresses and its
  // peer on every node are gone.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  // Lifetime totals from the nodes' per-peer counters, never reset (the
  // user's quota lives on UserTraffic). lastSeenAt: the last poll in which
  // the device moved bytes; a handshake alone does not count. NULL = never.
  bytesIn    BigInt    @default(0) @map("bytes_in")
  bytesOut   BigInt    @default(0) @map("bytes_out")
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(6)

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  peers AmneziawgPeer[]

  @@index([userId])
  @@map("wg_devices")
}

// ───── Slice S2: HWID enforcement ────────────────────────────────────────
//
// Tracks which physical client devices have fetched a user's subscription.
// Each row is a (userId, hwid) pair, populated lazily, on /sub/:token the
// middleware reads the `x-hwid` header (set by Hiddify/Streisand/Happ),
// upserts this row, then counts how many devices the user has and 403s
// if `count > user.hwidDeviceLimit`.
//
// Trust model: client-supplied HWID, this is a "concerned parent" gate,
// not anti-cheat. Spoofing the header on the client trivially bypasses
// it. Acceptable: the goal is preventing casual subscription sharing, not
// hardening against adversarial users.
model HwidUserDevice {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  hwid        String   @db.VarChar(255)
  // First time we saw this device, for audit / "device added" UI later.
  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  // Updated on every /sub/:token hit so admins can see stale devices.
  lastSeenAt  DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  // Optional admin label ("Phone", "Laptop"), set via API later, NULL by default.
  label       String?  @db.VarChar(64)
  // What the client says about itself on /sub (x-device-os, x-ver-os,
  // x-device-model, User-Agent), as of the last fetch that sent it.
  platform    String?  @db.VarChar(64)
  osVersion   String?  @map("os_version") @db.VarChar(64)
  deviceModel String?  @map("device_model") @db.VarChar(128)
  userAgent   String?  @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Same physical device hitting the same user's subscription is one row,
  // not a fresh insert per request.
  @@unique([userId, hwid])
  @@index([userId])
  @@map("hwid_user_devices")
}
