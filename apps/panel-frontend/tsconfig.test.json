{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vite/client", "node", "@testing-library/jest-dom"],
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  // `extends` carries tsconfig.app.json's exclude across, and exclude filters
  // include - so without this line the test project resolves to zero files and
  // `tsc -p tsconfig.test.json` passes by having nothing to check.
  "exclude": [],
  // e2e/ and the Playwright config live outside src/ (they are not the app),
  // so this is the only project that checks them.
  "include": ["src/**/*.ts", "src/**/*.tsx", "e2e/**/*.ts", "playwright.config.ts"]
}
