{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": { "@/*": ["./src/*"] },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  /* The form tests load the backend's schemas through `@backend`; the image holds no backend
     sources, so they are type-checked by tsconfig.forms.json (in `tsc -b`, not in `build`). */
  "exclude": [
    "src/test-support/backendSchemas.test.ts",
    "src/test/cascadeForms.test.tsx",
    "src/test/hostForms.test.tsx",
    "src/test/namedOutboundForms.test.ts",
    "src/test/nodeForms.test.tsx",
    "src/test/nodePolicyForms.test.tsx",
    "src/test/settingsForms.test.tsx",
    "src/test/squadForms.test.tsx",
    "src/test/subscriptionForms.test.tsx",
    "src/test/userForms.test.tsx"
  ]
}
