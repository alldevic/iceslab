# nginx config for the panel-frontend container.
#
# Two responsibilities:
#   1. Serve the Vite-built SPA with client-side-routing fallback.
#   2. Reverse-proxy the backend's PUBLIC paths so the browser, a subscriber's
#      client and the storefront all see a single origin (no CORS).
#
# This is a TEMPLATE, rendered by the nginx image's own entrypoint
# (`/etc/nginx/templates/*.template` → `/etc/nginx/conf.d/`) because two of
# those paths are operator-configurable on the backend and a hardcoded
# `location` cannot follow them:
#
#   ICESLAB_SUB_PREFIX     = the backend's SUBSCRIPTION_PATH_PREFIX (`/sub`),
#                            which an operator changes to mask the panel's
#                            signature in user links (`/v`, `/get`).
#   ICESLAB_COMPAT_PREFIX  = the backend's REMNAWAVE_COMPAT_PREFIX (`rw`),
#                            where the storefront facade is mounted.
#
# `NGINX_ENVSUBST_FILTER=^ICESLAB_` (set in the Dockerfile) is what keeps the
# substitution to those two: without it envsubst would also eat `$host`,
# `$uri`, `$backend` and every other nginx variable in this file whose name
# happens to exist in the environment.
#
# Every location that forwards is here because the backend answers there and
# NOTHING ELSE DOES. The SPA fallback at the bottom is a catch-all that returns
# index.html with HTTP 200 for any path, so a public backend path missing from
# this list does not 404 — it silently serves HTML to a client expecting a
# subscription, a geo database or a JSON API. That failure is invisible from
# the backend side, which is why `image-selftest.sh` starts this container and
# asks it, rather than reading this file.
#
# The upstream `backend` resolves via Docker Compose's service DNS, that
# means this image is opinionated for our compose topology. If you front
# the panel with Traefik/Caddy/your-own-nginx, mount your own conf over
# this file or override via a volume.

# Docker's embedded DNS resolver. Without an explicit `resolver` directive,
# nginx resolves upstreams via gethostbyname() ONCE at startup and caches
# the IP forever, so when the backend container gets a fresh IP after a
# restart, every proxied request 502s until nginx itself is restarted.
# Combined with `set $backend ... ; proxy_pass http://$backend` below, this
# forces a runtime lookup with a 10-second cache. ipv6=off because Compose
# networks don't ship IPv6 records and lookups would block on AAAA.
resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # I9 - bound request bodies. The panel's API payloads (user/profile/node
    # forms, raw configs) are small; 2m is generous headroom while capping the
    # hysteria auth-callback / any proxied POST so an oversized body can't be
    # used to pressure the backend. Applies to proxied locations too.
    client_max_body_size 2m;

    # ───── Security headers ─────
    # Defence-in-depth for the admin panel. `always` sends them on error
    # responses too. nginx does NOT merge add_header into child locations that
    # declare their own add_header, so the two cache locations below include
    # the same snippet rather than re-typing the list.
    #
    # I9 - CSP ships in REPORT-ONLY mode: it does NOT block anything, only logs
    # violations to the browser console, so an operator can confirm the policy
    # fits their deployment (Mantine injects runtime <style> tags -> the
    # 'unsafe-inline' style-src; Vite prod scripts are external -> 'self').
    # Once verified, switch the header name to `Content-Security-Policy` to
    # enforce. `connect-src 'self'` assumes same-origin API only (the nginx
    # /api proxy) - widen it if the SPA ever calls an external host directly.
    set $csp "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'";
    server_tokens off;
    include /etc/nginx/snippets/security-headers.conf;

    # The variable in proxy_pass is what activates the runtime resolver
    # path. With a static upstream{} block (the previous setup), nginx
    # short-circuits the resolver entirely, leading to the stale-IP bug.
    # Address, not a name baked into the image. It defaults to `backend:3000`,
    # the compose service this image ships next to, so the bundled deploy
    # renders byte-identical to before. Anything fronting the panel differently
    # - the minishop stand, a single-host install, someone else's topology -
    # sets ICESLAB_BACKEND_ADDR instead of mounting a whole conf over this file,
    # which is what the header above used to have to suggest.
    #
    # An IP:port needs no resolution at all; a NAME is resolved through the
    # resolver above, i.e. through docker's embedded DNS, so it has to be one
    # that DNS answers - a compose service name, not an /etc/hosts alias like
    # host.docker.internal (a variable proxy_pass never reads /etc/hosts).
    set $backend "${ICESLAB_BACKEND_ADDR}";

    # ───── API proxy ─────
    location /api/ {
        proxy_pass http://$backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # ───── Honeypot scanner paths ─────
    # Cycle #6 reality-check 2026-05-12: honeypot trap in backend's
    # security-gate (lib/security-gate.ts) never fired in production because
    # scanner paths like /.env, /wp-admin, /xmlrpc.php were caught by the
    # SPA fallback below and served index.html (200 OK) instead of reaching
    # the backend at all. Forward known scanner prefixes to the backend so
    # the Tier-1 trap (404 fake HTML + IP blacklist + Telegram alert) can
    # actually fire. Case-insensitive so /Wp-Admin / /.GIT/ don't dodge.
    location ~* ^/(\.env(\b|$)|\.git/|\.aws/|wp-admin|wp-login|wp-config\.php|xmlrpc\.php|phpinfo\.php|server-status|phpmyadmin|wordpress) {
        proxy_pass http://$backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 10s;
    }

    # The subscription a buyer's client polls. `^~` so the regex static-asset
    # location below can never win on a path that happens to end in a known
    # extension — this location serves the backend's HTML subscription page as
    # well as the config formats.
    location ^~ ${ICESLAB_SUB_PREFIX}/ {
        proxy_pass http://$backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Self-hosted geo distribution (GEO_SELF_HOST). Subscriptions and node
    # configs point their geo databases at PUBLIC_URL/geo/<token>/<name>, so
    # without this the artefact request lands on the SPA fallback and a client
    # parses index.html as a .dat. `^~` is required here rather than tidy:
    # artefact names carry extensions.
    location ^~ /geo/ {
        proxy_pass http://$backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # A geo artefact is tens of MB off the backend's heap; the default 60s
        # is for an API call, not for a mirror download over a slow link.
        proxy_read_timeout 300s;
    }

    # The Remnawave-compat facade (REMNAWAVE_COMPAT_ENABLED). The storefront is
    # documented to point PANEL_API_URL at `https://<panel-host>/<prefix>/api`
    # — this host — and the buyer's client fetches the fallback subscription
    # link at `/<prefix>/api/sub/<token>`. Forwarded whether or not the facade
    # is switched on: with it off the backend answers 404, which is the truth,
    # while the SPA fallback answers 200 with HTML, which is not.
    location ^~ /${ICESLAB_COMPAT_PREFIX}/ {
        proxy_pass http://$backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location = /health {
        proxy_pass http://$backend;
    }

    # Bull-board UI mounted by panel-backend at /admin/queues. Without
    # this rule the SPA fallback below catches the path and serves
    # index.html, React Router doesn't know /admin/queues and bounces
    # the user to /. Proxy the whole /admin/ prefix so backend tooling
    # (current: Bull-board; future: any server-rendered admin page)
    # reaches the user's browser.
    #
    # ^~ modifier is mandatory: bull-board fetches its own bundle from
    # /admin/queues/static/js/*.js and *.css. Without ^~, the regex
    # location below (\.(?:js|css|...)$) wins by nginx priority rules
    # and tries `try_files $uri =404` against the SPA disk root,
    # all bull-board assets return 404, the dashboard freezes on
    # "Loading...". ^~ tells nginx "if this prefix matches, skip the
    # regex round entirely".
    location ^~ /admin/ {
        proxy_pass http://$backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # ───── Static assets ─────
    # Vite emits content-hashed filenames, so we can cache them aggressively.
    location ~* \.(?:js|css|woff2?|ttf|eot|svg|ico|png|jpg|jpeg|gif|webp)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        # Re-included, not re-typed: this location's own add_header drops every
        # header inherited from the server block, all of them, always.
        include /etc/nginx/snippets/security-headers.conf;
        access_log off;
        try_files $uri =404;
    }

    # index.html is the cache-bust point, never cache it.
    location = /index.html {
        expires -1;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        # This is the location that made the duplication worth removing: it is
        # where `/` and every SPA route land (try_files rewrites to
        # /index.html), so a header missing here is a header the browser never
        # sees on the document it applies to.
        include /etc/nginx/snippets/security-headers.conf;
    }

    # SPA fallback: client-side routes resolve to index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types
        text/plain
        text/css
        text/xml
        application/javascript
        application/json
        application/xml
        image/svg+xml;
}
